<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.msa4lms.domain.enrollment.mapper.EnrollmentMapper">

<!--    [Step 3 완료] 드디어 데이터베이스에서 정보를 긁어올 "지도"인 Mapper XML을 완성했습니다.-->

<!--    1. 데이터 무결성: "수강신청(enrollments) 테이블을 기준으로, 강의(lectures), 과목(courses), 교수(users)
        테이블을 모두 JOIN 하여 학생이 한 번의 요청으로 모든 상세 정보를 볼 수 있게 최적화했습니다." -->
<!--    2. 비즈니스 로직: "단순 조회가 아니라 status != 'DROPPED' 조건을 넣어, 수강 취소한 과목은 총 학점 계산에서 제외되도록 세밀하게 설계했습니다."-->
<!--    3. 예외 처리: "신청 과목이 하나도 없을 경우 SUM 함수가 NULL을 반환할 수 있는데, 이를 방지하기 위해 IFNULL(..., 0) 처리를 추가했습니다."-->


<!--    namespace-->
<!--    * 설명: 이 XML이 어떤 자바 인터페이스와 짝꿍인지 알려줍니다.-->
<!--    * 핵심: EnrollmentMapper 인터페이스의 패키지 경로를 정확히 적어야 합니다. 이게 틀리면 자바에서 메서드를 호출할 때 "쿼리를 찾을 수 없다"는 에러가 납니다.-->

<!--    id와 resultType-->
<!--    * id: 인터페이스의 메서드 이름과 똑같이 맞춰야 합니다.-->
<!--    * resultType: 쿼리 결과를 자바의 어떤 객체(우리가 만든 DTO)에 담을지 결정합니다. $EnrollmentDetail은 dto의 내부 클래스를 뜻합니다.-->

<!--    c.code AS courseCode (Alias)-->
<!--    * 왜 쓰나요? DB 컬럼명은 code인데, 우리 자바 DTO 변수명은 courseCode입니다. 이름이 다르면 데이터가 안 들어갑니다.-->
<!--    * 얻는 것: AS를 써서 자바 변수명에 맞게 이름을 바꿔주어 자동으로 데이터가 매핑되게 합니다.-->

<!--    JOIN (4단 결합)-->
<!--    *  FROM enrollments e: 메인입니다. 학생의 "신청 내역"부터 시작합니다.-->
<!--    *  JOIN lectures l: 신청 내역에는 강의실이나 시간 정보가 없습니다. 그래서 "강의" 테이블과 합칩니다.-->
<!--    *  JOIN courses c: 강의 테이블에는 과목 이름이 없습니다. 그래서 "과목" 테이블과 합칩니다.-->
<!--    *  JOIN users u: 강의 테이블에는 교수님 ID만 있습니다. 성함을 알기 위해 "사용자" 테이블과 합칩니다.-->

<!--    [10] WHERE 절과 #{...}-->
<!--    * 설명: 자바에서 넘겨준 파라미터(studentId, year 등)를 쿼리에 안전하게 주입합니다.-->

<!--    학점 합계 (SUM)-->
<!--    IF NULL(SUM(...), 0): 수강 신청을 하나도 안 했으면 합계가 NULL이 나옵니다. 자바의 int는 NULL을 못 받으므로 0으로 바꿔줍니다.-->
<!--    status != 'DROPPED': 이게 진짜 실무 로직입니다. 학생이 '수강 취소'를 한 과목은 학점에서 빼야 합니다.-->

    <!-- 특정 학생의 수강 내역을 조회하는 쿼리 -->
    <select id="findMyEnrollments" resultType="com.msa4lms.domain.enrollment.dto.MyEnrollmentListRes$EnrollmentDetail">
        SELECT
            e.id,
            c.code AS courseCode,
            c.name AS courseName,
            u.name AS professorName,
            l.room,
            l.schedule,
            c.credits,
            e.status
        FROM enrollments e
        JOIN lectures l ON e.lecture_id = l.id
        JOIN courses c ON l.course_id = c.id
        JOIN users u ON l.professor_id = u.id
        WHERE e.student_id = #{studentId}
          AND l.year = #{year}
          AND l.semester = #{semester}
    </select>

    <!-- 이번 학기 신청한 총 학점을 계산하는 쿼리 -->
    <select id="calculateTotalCredits" resultType="int">
        SELECT IFNULL(SUM(c.credits), 0)
        FROM enrollments e
        JOIN lectures l ON e.lecture_id = l.id
        JOIN courses c ON l.course_id = c.id
        WHERE e.student_id = #{studentId}
          AND l.year = #{year}
          AND l.semester = #{semester}
          AND e.status != 'DROPPED'
    </select>

</mapper>
